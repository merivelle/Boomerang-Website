# Contact form email (SMTP via nodemailer) — used by app/api/contact/route.ts
# Copy to .env.local for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables.
#
# Values below are for the Bluehost cPanel mailbox info@boomerang-music.com.
# SMTP_PASS is the mailbox password (cPanel → Email Accounts → info@… → Manage) —
# put it in .env.local / Vercel only, NEVER commit it.
# If mail.boomerang-music.com gives a TLS certificate error, use SMTP_PORT=587 and SMTP_SECURE=false.

SMTP_HOST=mail.boomerang-music.com
SMTP_PORT=465            # 465 (SSL) or 587 (STARTTLS)
SMTP_SECURE=true         # "true" for 465, "false" for 587
SMTP_USER=info@boomerang-music.com
SMTP_PASS=

CONTACT_TO=info@boomerang-music.com
CONTACT_FROM=info@boomerang-music.com   # optional; defaults to SMTP_USER
