# Contact form email (Resend) — used by app/api/contact/route.ts
# Copy to .env.local for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables.
#
# RESEND_API_KEY is a secret: keep it in .env.local / Vercel only, NEVER commit it.
# Don't put trailing "# comments" after a value here — they're easy to copy into
# a real .env.local by accident, and a stray comment becomes part of the value.

RESEND_API_KEY=

CONTACT_TO=info@boomerang-music.com

# Must be an address on a domain verified in Resend. Leave blank and the route
# falls back to Resend's shared onboarding sender, which can only deliver to the
# Resend account owner's own address — fine for a first smoke test, not for live.
CONTACT_FROM=info@boomerang-music.com


# ─────────────────────────────────────────────────────────────────────────────
# Supabase — the content database behind /admin
#
# Create a project at supabase.com (free tier), then copy these from
# Project Settings → API. Put them in .env.local for local dev and in
# Vercel → Settings → Environment Variables for the deployed site.

# Safe to expose: this key is in the client bundle by design, and RLS only lets
# it SELECT published content.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. Bypasses every RLS policy. Used only by the migration script, the
# admin write path, and the contact route's inquiry insert.
# NEVER give this a NEXT_PUBLIC_ prefix and never import it from a "use client" file.
SUPABASE_SERVICE_ROLE_KEY=

# Salt for hashing inquiry IP addresses. Any long random string.
# We store sha256(ip + salt) so rate-limiting works without keeping a log of who visited.
INQUIRY_IP_SALT=
